# Copia este archivo como ".env" y completa los valores reales.
# Nunca subas el archivo ".env" real a un repositorio.
# Si un valor (ej. DB_PASSWORD) contiene "#", envuélvelo en comillas dobles,
# o dotenv lo interpretará como el inicio de un comentario y lo truncará.

NODE_ENV=development
PORT=4000

# --- Base de datos SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=PanaderiaApp
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- JWT ---
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- Seguridad ---
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5

# --- APIs externas (apiperu.dev: consulta real de DNI/RUC) ---
API_PERU_TOKEN=
API_PERU_BASE_URL=https://apiperu.dev/api

# --- SMS (Twilio) para verificar celular por código ---
# Si se dejan vacías, el código NO se envía de verdad: se imprime en la
# consola del servidor (modo desarrollo), útil para probar el flujo entero
# sin gastar SMS reales. Crea una cuenta en https://www.twilio.com/ para
# obtener estos 3 valores.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Correo (Gmail API vía OAuth2) para verificar email por PIN ---
# Igual que con SMS: si se dejan vacías, el PIN se imprime en consola en vez
# de enviarse de verdad. NO usar SMTP (Gmail u otro): Render no permite
# conexiones salientes por el puerto 587/465, se cuelga ~2min y falla con
# ETIMEDOUT — la Gmail API usa HTTPS (443), que sí funciona.
# Para obtenerlas: crea un proyecto en console.cloud.google.com, habilita la
# Gmail API, crea credenciales OAuth (tipo "Aplicación web", con
# https://developers.google.com/oauthplayground como URI de redirección
# autorizada), y usa developers.google.com/oauthplayground (con tus propias
# credenciales, scope https://www.googleapis.com/auth/gmail.send) para
# autorizar la cuenta que enviará los correos y obtener el refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=

# --- Página web pública (pagina-web/) ---
# Base del enlace que lleva el correo de activación de cuenta
# ({URL}/activar-cuenta?p=...&t=...). Sin slash final. Si se deja vacía se
# usa https://panaderiaronceros.com; en desarrollo, apuntarla al Vite local
# (http://localhost:5173) para poder probar el flujo de punta a punta.
URL_PAGINA_WEB=

# --- Microservicio de predicción de demanda (ml_service/, FastAPI) ---
# Si se deja vacía, GET /api/prediccion-demanda/:idTienda/:idProducto
# responde 503 ("todavía no está desplegado") en vez de fallar feo.
# URL base del servicio, sin slash final, ej: https://panaderia-ml-service.onrender.com
ML_SERVICE_URL=

# --- Pasarela de pago CULQI (tarjeta) para el pedido web de Panadería ---
# La llave SECRETA del panel de Culqi (Desarrollo → API Keys):
# sk_live_... en producción, sk_test_... para probar sin cobrar de verdad.
# Si se deja vacía, POST /api/publico/pedidos/:id/pagar-culqi responde 503
# ("los pagos con tarjeta no están configurados todavía") en vez de fallar
# feo — y el interruptor EXIGE_PAGO_ADELANTADO_PANADERIA de Configuraciones
# NO se debe encender mientras siga así, porque ningún pedido de pan se
# podría completar.
# NUNCA poner acá la pública (pk_...): esa va en pagina-web (ver abajo).
CULQI_SECRET_KEY=

# ⚠️ `pagina-web/` necesita además, en SU propio entorno (Vercel → Settings →
#    Environment Variables, o un .env local para el Vite de desarrollo):
#        VITE_CULQI_PUBLIC_KEY=pk_live_...
#    Es la llave PÚBLICA: Culqi.js la usa en el navegador para convertir los
#    datos de la tarjeta en un token de un solo uso, y con ella no se puede
#    cobrar. El cargo lo crea este backend con la secreta. Las dos llaves
#    tienen que ser del MISMO entorno (pk_test_ con sk_test_, pk_live_ con
#    sk_live_): cruzarlas hace que Culqi rechace el token.
