# Copia este archivo como ".env" y completa los valores reales.
# Nunca subas el archivo ".env" real a un repositorio.
# Si un valor (ej. DB_PASSWORD) contiene "#", envuélvelo en comillas dobles,
# o dotenv lo interpretará como el inicio de un comentario y lo truncará.

NODE_ENV=development
PORT=4000

# --- Base de datos SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=PanaderiaApp
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- JWT ---
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- Seguridad ---
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5

# --- APIs externas (apiperu.dev: consulta real de DNI/RUC) ---
API_PERU_TOKEN=
API_PERU_BASE_URL=https://apiperu.dev/api

# --- SMS (Twilio) para verificar celular por código ---
# Si se dejan vacías, el código NO se envía de verdad: se imprime en la
# consola del servidor (modo desarrollo), útil para probar el flujo entero
# sin gastar SMS reales. Crea una cuenta en https://www.twilio.com/ para
# obtener estos 3 valores.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Correo (SMTP) para verificar email por PIN ---
# Igual que con SMS: si se dejan vacías, el PIN se imprime en consola en vez
# de enviarse de verdad. Con Gmail: activa verificación en 2 pasos en la
# cuenta y genera una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords — usa esa contraseña aquí, NO
# la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Corporación Ronceros <no-reply@corporacionronceros.com>"
